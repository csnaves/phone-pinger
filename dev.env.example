# Dev instance settings for dev.ps1. Copy to dev.env (gitignored) and fill in.
# Every value must differ from production; dev.ps1 refuses to start otherwise.
ICLOUD_EMAIL=<dev-apple-id-email>
ICLOUD_PASSWORD=<dev-apple-id-password>
ICLOUD_DEVICE_ID=<dev-device-id>
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCATOR_TOKEN=<random-token>
